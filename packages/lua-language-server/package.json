          "lua-language-server-3.19.2-win32-arm64.zip": "https://github.com/xbghc/mason-win-arm64/releases/download/2026-11-15/lua-language-server-3.19.2-win32-arm64.zip"
        }
      },
      {
        "target": "win_x64",
